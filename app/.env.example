# RPC de Alchemy para Monad testnet (dashboard.alchemy.com)
NEXT_PUBLIC_RPC_URL=
# Webhooks de Alchemy (solo servidor, sin NEXT_PUBLIC_)
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=

# Asistente con Qwen (Alibaba Cloud Model Studio); solo servidor.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
# Solo desarrollo: 1 = usar un planificador de reglas (NO es Qwen) si no hay clave
AGENTE_SIMULADO=

# Minutos de inactividad antes de bloquear la sesion (por defecto 10). Con 2 se demuestra la expiracion en el video.
NEXT_PUBLIC_SESSION_MINUTES=

# Indexador de Aval (Envio HyperIndex, GraphQL). Solo servidor. Pidele la URL a Alan (termina en /v1/graphql).
INDEXER_URL=
